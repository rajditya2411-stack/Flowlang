# If / Elif / Else Multi-branch
score = 85
if score >= 90:
    print("Grade: A")
elif score >= 80:
    print("Grade: B")
elif score >= 70:
    print("Grade: C")
else:
    print("Grade: F")

score2 = 65
if score2 >= 90:
    print("Grade: A")
elif score2 >= 80:
    print("Grade: B")
elif score2 >= 70:
    print("Grade: C")
else:
    print("Grade: F")
