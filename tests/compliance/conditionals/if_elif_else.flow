# If / Elif / Else Multi-branch
lit score = 85
if score >= 90 {
    say("Grade: A")
} elif score >= 80 {
    say("Grade: B")
} elif score >= 70 {
    say("Grade: C")
} else {
    say("Grade: F")
}

lit score2 = 65
if score2 >= 90 {
    say("Grade: A")
} elif score2 >= 80 {
    say("Grade: B")
} elif score2 >= 70 {
    say("Grade: C")
} else {
    say("Grade: F")
}
