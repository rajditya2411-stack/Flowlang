# FlowLang V1 Loops
say("--- Loop 1: for (0; i < 5; i = i + 1) ---")
for i in (0; i < 5; i = i + 1) {
    say("Step:", i)
}

say("--- Loop 2: while loop countdown ---")
int count = 5
while count > 0 {
    say("Countdown:", count)
    count = count - 1
}
say("Blast off!")

say("--- Loop 3: do-while loop ---")
int n = 0
do {
    say("Do-while count:", n)
    n = n + 1
} while n < 3
